<section
  id='reservations'
  class='reservation section-spacing'
  aria-labelledby='reservation-heading'
>
  <div class='container reservation__container'>
    <header class='section-header reservation__header  {{#if isFull}} reservation__header--full {{/if}}'>
      <h2
        id='reservation-heading'
        class='text-h2 color-primary {{#if isFull}} reservation__title {{/if}}'
      >Make a Reservation</h2>
      <p class='subtitle  {{#if isFull}} reservation__subtitle {{/if}}'>Get in touch with restaurant</p>
    </header>

    <form
      action="/"
      method="POST"
      class="reservation__form"
    >
      <fieldset>
        <legend class="sr-only">Details of reservation</legend>

        <!-- Grid layout changes dynamically based on the isFull parameter -->
        <div class="form-grid {{#if isFull}}form-grid--full{{else}}form-grid--simple{{/if}}">

          {{#if isFull}}
            <!-- First Name (Col 1 on Desktop) -->
            <div class="input-group">
              <label
                for="reservation-first-name"
                class="sr-only"
              >First Name</label>
              <input
                type="text"
                id="reservation-first-name"
                name="first_name"
                placeholder="First Name"
                autocomplete="given-name"
                required
                class="form-control"
              />
            </div>

            <!-- Last Name (Col 2 on Desktop) -->
            <div class="input-group">
              <label
                for="reservation-last-name"
                class="sr-only"
              >Last Name</label>
              <input
                type="text"
                id="reservation-last-name"
                name="last_name"
                placeholder="Last Name"
                autocomplete="family-name"
                required
                class="form-control"
              />
            </div>

            <!-- Email (Full width on Desktop) -->
            <div class="input-group input-group--full-width">
              <label
                for="reservation-email"
                class="sr-only"
              >Email Address</label>
              <input
                type="email"
                id="reservation-email"
                name="email"
                placeholder="Email"
                autocomplete="email"
                required
                class="form-control"
              />
            </div>

            <!-- Phone (Full width on Desktop) -->
            <div class="input-group input-group--full-width">
              <label
                for="reservation-phone"
                class="sr-only"
              >Phone Number</label>
              <input
                type="tel"
                id="reservation-phone"
                name="phone"
                placeholder="Phone"
                autocomplete="tel"
                required
                class="form-control"
              />
            </div>
          {{/if}}

          <!-- Date -->
          <div class="input-group">
            <label
              for="reservation-date"
              class="sr-only"
            >Date of reservation</label>
            <input
              type="date"
              id="reservation-date"
              name="date"
              value="2026-06-22"
              required
              class="form-control form-control--date"
            />
            <svg
              class="input-icon"
              aria-hidden="true"
            >
              <use href="#icon-angle-down"></use>
            </svg>
          </div>

          <!-- Time -->
          <div class="input-group">
            <label
              for="reservation-time"
              class="sr-only"
            >Time of reservation</label>
            <input
              type="time"
              id="reservation-time"
              name="time"
              value="18:00"
              step="1800"
              required
              class="form-control form-control--time"
            />
            <svg
              class="input-icon"
              aria-hidden="true"
            >
              <use href="#icon-angle-down"></use>
            </svg>
          </div>

          <!-- Party Size (Full width on Full Form, 1/3 width on Simple Form) -->
          <div class="input-group {{#if isFull}}input-group--full-width{{/if}}">
            <label
              for="reservation-party"
              class="sr-only"
            >Number of person</label>
            <select
              id="reservation-party"
              name="party_size"
              required
              class="form-control form-control--select"
            >
              <option value="1">1 Person</option>
              <option
                value="2"
                selected
              >2 Person</option>
              <option value="3">3 Person</option>
              <option value="4">4 Person</option>
              <option value="6">6 Person</option>
            </select>
            <svg
              class="input-icon"
              aria-hidden="true"
            >
              <use href="#icon-angle-down"></use>
            </svg>
          </div>
        </div>
      </fieldset>
      <button
        type="submit"
        class="btn btn--primary"
      >Book Now</button>
    </form>
  </div>
</section>