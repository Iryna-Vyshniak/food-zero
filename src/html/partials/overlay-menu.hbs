<dialog
  class="overlay-menu"
  id="mobile-menu"
  aria-label="Mobile navigation menu"
>
  <button
    class="overlay-menu__close"
    id="menu-close-btn"
    type="button"
    aria-label="Close menu"
  >
    <svg
      class="icon-close"
      aria-hidden="true"
    >
      <use href="#icon-close"></use>
    </svg>
  </button>

  <div class="container overlay-menu__inner section-spacing">
    <div class="overlay-menu__body">
      <nav
        aria-label="Overlay navigation"
        class="overlay-menu__nav"
      >
        <h2
          id="overlay-title"
          class="sr-only"
        >Site navigation</h2>
        <ul class="overlay-nav__list">
          <li><a
              href="/"
              class="overlay-nav__link"
            >Home</a></li>
          <li><a
              href="/menu.html"
              class="overlay-nav__link"
            >Menu</a></li>

          <li class="overlay-nav__item">
            <button
              class="overlay-nav__toggle"
              type="button"
              aria-expanded="false"
              aria-controls="blogs-submenu"
            >
              Blogs
            </button>
            <ul
              class="overlay-nav__sublist"
              id="blogs-submenu"
            >
              <div class="overlay-nav__sublist-inner">
                <li><a
                    href="/bloglist.html"
                    class="overlay-nav__sublink"
                  >1 Column</a></li>
                <li><a
                    href="/singledish.html"
                    class="overlay-nav__sublink"
                  >Sidebar Post</a></li>
              </div>
            </ul>
          </li>

          <li><a
              href="/about.html"
              class="overlay-nav__link"
            >About</a></li>
          <li><a
              href="/contact.html"
              class="overlay-nav__link"
            >Contact</a></li>
        </ul>
      </nav>

      <aside
        class="overlay-menu__contact"
        aria-label="Contact Information"
      >
        <h2 class="overlay-menu__contact-title">Contact</h2>
        <div class="overlay-menu__contact-details">
          {{> address }}
          {{> social-links }}
        </div>
      </aside>
    </div>
  </div>
</dialog>